# Author:   Aayush Joglekar <aayush.joglekar@surf.nl>
#
# libconfig — core (required) dependency of libcxi (configure.ac:
# PKG_CHECK_MODULES libconfig >= 1.5). Verbatim clone of the upstream
# libconfig-1.8.1-GCCcore-13.3.0.eb easyconfig with the toolchain bumped to
# GCCcore-14.2.0 (the rompi-2025a generation); only the toolchain and build-dep
# versions change. The patch file resolves from the upstream easyconfigs tree.

easyblock = 'ConfigureMake'

name = 'libconfig'
version = '1.8.1'

homepage = 'https://hyperrealm.github.io/libconfig'
description = "Libconfig is a simple library for processing structured configuration files"

toolchain = {'name': 'GCCcore', 'version': '14.2.0'}

source_urls = ['https://hyperrealm.github.io/%(name)s/dist/']
sources = [SOURCE_TAR_GZ]
# No patch here: this libconfig-1.8.1 tarball already ships
# examples/c/pathbuf.h, so the upstream `missing_pathbuf_header` patch (which
# *creates* that file) is redundant and fails ("file already exists").
checksums = [{SOURCE_TAR_GZ: 'c73ee3d914ec68c99b61e864832931e9a7112eeabfb449dad217fd83e385cbdf'}]

builddependencies = [
    ('binutils', '2.42'),
    ('Bison', '3.8.2'),
    ('flex', '2.6.4'),
]


sanity_check_paths = {
    'files': ['include/%(name)s.h', 'include/%(name)s.h++', 'lib/%(name)s.a', 'lib/%(name)s++.a', 'lib/%(name)s.so', 'lib/%(name)s++.so'],
    'dirs': ['lib/pkgconfig'],
}

moduleclass = 'lib'
